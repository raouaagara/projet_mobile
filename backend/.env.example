# CatchOPP – Docker environment variables
# Copy this file to .env and adjust values before running docker-compose up

# MySQL credentials
MYSQL_ROOT_PASSWORD=SuperSecretRoot123!
MYSQL_USER=catchopp
MYSQL_PASSWORD=CatchOppPass456!

# JWT signing secret for UserMicroService (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-string-of-32-chars-or-more

# Gmail app password used by SubscriptionMicroService to send emails
MAIL_PASSWORD=

# AI (Gemini): AI tests, AI CV assistant, review moderation and support assistant.
# Free key at https://aistudio.google.com/apikey. Empty = those features say "AI isn't set up".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: AI tests with OpenAI instead (also set AI_PROVIDER=openai for the skill-tests service)
OPENAI_API_KEY=
